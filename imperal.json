{
  "manifest_schema_version": 3,
  "sdk_version": "5.13.1",
  "app_id": "tray-io-connector",
  "version": "0.1.0",
  "name": "Tray.io",
  "description": "Connect your own Tray.io workspace (classic Platform REST API, static Bearer token) to manage workflows (list/get/create/update/enable/disable/delete/duplicate), workflow executions, and authentications (metadata only, never secret values) -- plus workspace health reports.",
  "icon": "icon.svg",
  "actions_explicit": true,
  "system": false,
  "capabilities": [
    "tray:read",
    "tray:write"
  ],
  "tools": [
    {
      "name": "connect_tray",
      "description": "Connect a Tray.io workspace by saving its API token (Settings > Tokens in the Tray dashboard -- master or user token), after checking it actually works against GET /workflows.",
      "action_type": "write",
      "chain_callable": true,
      "effects": [
        "tray.connection.created"
      ],
      "id_projection": "",
      "params_schema": {
        "properties": {
          "label": {
            "default": "",
            "description": "A friendly name for this workspace, e.g. 'Acme production'.",
            "title": "Label",
            "type": "string"
          },
          "api_token": {
            "description": "Tray API token (Settings > Tokens in the Tray dashboard -- master or user token).",
            "title": "Api Token",
            "type": "string"
          }
        },
        "required": [
          "api_token"
        ],
        "title": "ConnectTrayParams",
        "type": "object"
      },
      "return_schema": {
        "properties": {
          "connected": {
            "title": "Connected",
            "type": "boolean"
          },
          "connection_id": {
            "default": "",
            "title": "Connection Id",
            "type": "string"
          },
          "label": {
            "default": "",
            "title": "Label",
            "type": "string"
          },
          "workflows_seen": {
            "default": 0,
            "title": "Workflows Seen",
            "type": "integer"
          }
        },
        "required": [
          "connected"
        ],
        "title": "ConnectTrayResult",
        "type": "object"
      },
      "event": "tray-io-connector.connection.created",
      "background": false,
      "long_running": false,
      "scopes": [],
      "owner_chat_tool": "tray"
    },
    {
      "name": "list_connections",
      "description": "List the connected Tray.io workspaces (masked token ids; secret values are never shown).",
      "action_type": "read",
      "chain_callable": true,
      "effects": [],
      "id_projection": "",
      "params_schema": {
        "properties": {
          "connection_id": {
            "default": "",
            "description": "Saved connection id; empty uses the most recent connection.",
            "title": "Connection Id",
            "type": "string"
          }
        },
        "title": "ConnectionIdParams",
        "type": "object"
      },
      "return_schema": {
        "$defs": {
          "ConnectionRecord": {
            "properties": {
              "id": {
                "title": "Id",
                "type": "string"
              },
              "label": {
                "title": "Label",
                "type": "string"
              },
              "token_masked": {
                "title": "Token Masked",
                "type": "string"
              }
            },
            "required": [
              "id",
              "label",
              "token_masked"
            ],
            "title": "ConnectionRecord",
            "type": "object"
          }
        },
        "properties": {
          "connections": {
            "items": {
              "$ref": "#/$defs/ConnectionRecord"
            },
            "title": "Connections",
            "type": "array"
          },
          "count": {
            "title": "Count",
            "type": "integer"
          }
        },
        "required": [
          "connections",
          "count"
        ],
        "title": "ConnectionList",
        "type": "object"
      },
      "event": "",
      "background": false,
      "long_running": false,
      "scopes": [],
      "owner_chat_tool": "tray"
    },
